# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Paystack Secret Key (e.g., sk_test_... or sk_live_...)
# Set in Secrets panel or environment. Keep strictly server-side.
PAYSTACK_SECRET_KEY="sk_test_placeholder_key"

# PAYSTACK_PUBLIC_KEY: Paystack Public Key (e.g., pk_test_... or pk_live_...)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_placeholder_key"

# PAYSTACK_WEBHOOK_SECRET: Secret used to verify Paystack HMAC SHA512 signatures (defaults to secret key)
PAYSTACK_WEBHOOK_SECRET="sk_test_placeholder_key"

# RESTAURANT_ADMIN_SECRET: Master passphrase for staff/admin dashboard
RESTAURANT_ADMIN_SECRET="naijagrill2025"
